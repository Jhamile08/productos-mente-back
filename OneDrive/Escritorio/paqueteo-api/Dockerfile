FROM node:14.17.1

WORKDIR '/home/paqueteo-api'

COPY package.json .
COPY package-lock.json .
COPY . .

RUN echo "deb http://archive.debian.org/debian stretch main contrib non-free" > /etc/apt/sources.list
RUN apt update -y

RUN npm install --unsafe-perm --arch=x64 --platform=linux sharp
RUN npm install

ENV AWS_REGION=AWS_REGION
ENV SERVER_PORT=SERVER_PORT
ENV SESSION_SECRET=SESSION_SECRET
ENV ENVIRONMENT=ENVIRONMENT
ENV POSTGRES_HOST=POSTGRES_HOST
ENV POSTGRES_USER=POSTGRES_USER
ENV POSTGRES_DB=POSTGRES_DB
ENV POSTGRES_PASSWORD=POSTGRES_PASSWORD
ENV POSTGRES_PORT=POSTGRES_PORT
ENV REDIS_HOST=REDIS_HOST
ENV REDIS_PORT=REDIS_PORT
ENV REDIS_KEY=REDIS_KEY
ENV AWS_REGION=AWS_REGION
ENV JWKS_URL=JWKS_URL
ENV COGNITO_APP_CLIENT_ID=COGNITO_APP_CLIENT_ID
ENV AZURE_CONNECTION_STRING=AZURE_CONNECTION_STRING

CMD ["npm", "run", "prod"]

EXPOSE 5000
